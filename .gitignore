# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# IDE
.idea/
.vscode/

# Данные и отчёты — только через DVC (в git лишь .gitignore и *.dvc)
/data/*
!/data/.gitignore
!/data/*.dvc
/reports/*
/tmp/
.dvc/cache
.dvc/tmp

# Сырые захваты и бинарники: PCAP большие, а *.exe в папках CTU-13 — настоящая малварь
*.exe
*.parquet
*.pcap
*.pcapng
!tests/fixtures/*.pcap
!tests/fixtures/*.pcapng

# Фича 002
# SOC-состояние аналитика (БД инцидентов, вердикты прогонов) — рабочие данные, не выход
# конвейера: ни в git, ни в DVC
/var/
# Журнал экспериментов MLflow — локальный, вне git и DVC
/mlruns/
mlflow.db
# Артефакт детектора — выход DVC-стадии train_detector (в git только .gitignore и *.dvc)
/models/*
!/models/.gitignore
!/models/*.dvc

# Фича 005: seed-ISO и образы брокерной машины (var/ уже игнорируется — строка для ясности).
# Скрипты и шаблоны стенда (stand/) лежат в git
/var/stand/
*.iso
