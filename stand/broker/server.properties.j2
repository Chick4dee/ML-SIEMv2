# Kafka {{ s.kafka_version }} в режиме KRaft combined: один узел — и брокер, и контроллер (research R1).
# Собран из stand/broker/server.properties.j2 и configs/stream.yaml командой `mlsiem stand seed-iso`.
process.roles=broker,controller
node.id=1
controller.quorum.voters=1@127.0.0.1:9093
# Клиенты — только в служебной сети; контроллер — только локально на машине
listeners=PLAINTEXT://{{ s.broker_ip }}:9092,CONTROLLER://127.0.0.1:9093
advertised.listeners=PLAINTEXT://{{ s.broker_ip }}:9092
controller.listener.names=CONTROLLER
inter.broker.listener.name=PLAINTEXT
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
log.dirs=/var/lib/kafka
# Топики создаёт только установочный скрипт: опечатка в имени топика у клиента должна быть
# ошибкой, а не новым пустым топиком
auto.create.topics.enable=false
num.partitions={{ t.partitions }}
default.replication.factor=1
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
min.insync.replicas=1
log.retention.hours={{ t.retention_hours }}
log.segment.bytes=268435456
