#cloud-config
# Автоустановка Ubuntu Server 24.04 для машины-ЖЕРТВЫ {{ lab.victim.vm }} (фича 006, R1–R4).
# Собрано командой `mlsiem stand seed-iso --role victim` из stand/broker/user-data-victim.yaml.j2
# и configs/stream.yaml — руками не правят: поменяйте конфиг или шаблон и пересоберите.
#
# Машина стоит ТОЛЬКО в сети стенда {{ s.lab_switch }} (адрес статический, по MAC). Установочный
# адаптер (Default Switch, DHCP) нужен лишь на время установки пакетов — потом его отключает
# stand/hyperv/45-post-install.ps1. Службы пустые: на машине нет данных владельца (FR-003).
autoinstall:
  version: 1
  # IPv6 через Default Switch Hyper-V в интернет не ходит (ICS его не маршрутизирует), а apt
  # видит IPv6-адрес зеркала и виснет на таймауте. Отключаем IPv6 в установщике до любых
  # сетевых операций — тогда apt (и Mirror, и in-target) идёт по IPv4 и не зависает.
  early-commands:
    - sysctl -w net.ipv6.conf.all.disable_ipv6=1
    - sysctl -w net.ipv6.conf.default.disable_ipv6=1
  locale: ru_RU.UTF-8
  keyboard:
    layout: us
  timezone: UTC
  # ПОЛНЫЙ образ сервера (не -minimal): e2fsprogs, curl, python3 и прочая база уже в системе,
  # поэтому curtin на шаге «installing missing packages» НИЧЕГО не качает из сети. На minimal
  # этот онлайн-шаг на нестабильном NAT/зеркале то падал (install_fail), то висел.
  # Зеркало задаём ЖЁСТКО и выключаем geoip: иначе установщик выбирает страновое зеркало,
  # которое может висеть, хотя archive.ubuntu.com отвечает. Это убирает зависание apt-get update.
  apt:
    geoip: false
    primary:
      - arches: [default]
        uri: "http://archive.ubuntu.com/ubuntu"
  source:
    id: ubuntu-server
  storage:
    layout:
      name: direct
  network:
    version: 2
    ethernets:
      lab:
        match:
          macaddress: "{{ lab.lab_mac.victim }}"
        set-name: lab0
        dhcp4: false
        # Без шлюза: из сети стенда наружу пути нет (изоляция, FR-005)
        addresses:
          - {{ lab.victim.ip }}/{{ lab.subnet.prefixlen }}
      install:
        match:
          macaddress: "{{ lab.lab_mac.victim_install }}"
        set-name: inst0
        dhcp4: true
        # DNS от DHCP (Default Switch → туннель) резолвит имена через раз — apt виснет на
        # разрешении имени зеркала. Берём адрес по DHCP, но DNS жёстко свой, надёжный.
        dhcp4-overrides:
          use-dns: false
        nameservers:
          addresses: [8.8.8.8, 1.1.1.1]
        optional: true
        # MTU уменьшен: интернет ВМ идёт через Default Switch, а тот — через VPN-туннель хоста
        # (sing-tun). У туннеля меньший размер пакета, поэтому крупные загрузки apt со стандартным
        # MTU 1500 застревают (PMTUD blackhole). 1280 гарантированно пролезает через любой туннель.
        mtu: 1280
  ssh:
    install-server: true
    # Пароль нужен только тестовой учётке labuser: это цель сценария подбора пароля
    allow-pw: true
  # ВАЖНО: службы (особенно dnsmasq) ставим НЕ здесь, а в runcmd при первой загрузке.
  # Если ставить dnsmasq на этапе curtin, его postinst пытается занять порт 53, который держит
  # systemd-resolved, apt возвращает ошибку — и вся автоустановка падает (install_fail). На
  # первой загрузке мы сперва отключаем stub-слушатель resolved, и конфликта нет.
  packages:
    - curl
  user-data:
    hostname: {{ lab.victim.vm }}
    users:
      # Сопровождение стенда: вход по ключу хоста, пароля нет
      - name: {{ s.admin_user }}
        groups: [sudo]
        shell: /bin/bash
        lock_passwd: true
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        ssh_authorized_keys:
          - {{ pubkey }}
      # Тестовая учётка: заведомо слабый пароль из configs/stream.yaml (lab.victim.ssh_password),
      # без прав и без данных; существует только внутри изолированной сети стенда
      - name: {{ lab.victim.ssh_user }}
        shell: /bin/bash
        lock_passwd: false
    chpasswd:
      expire: false
      users:
        - name: {{ lab.victim.ssh_user }}
          password: {{ lab.victim.ssh_password }}
          type: text
    write_files:
      # Та же причина (IPv6 Default Switch): apt установленной системы — только IPv4, иначе
      # установка служб/инструментов на первой загрузке зависнет так же, как установщик
      - path: /etc/apt/apt.conf.d/99force-ipv4
        permissions: "0644"
        content: |
          Acquire::ForceIPv4 "true";
      - path: /var/www/html/index.html
        permissions: "0644"
        content: |
          <html><body><h1>mlsiem lab victim</h1><a href="/login">login</a>
          <a href="/admin">admin</a><a href="/api/status">api</a></body></html>
      - path: /var/www/html/login/index.html
        permissions: "0644"
        content: |
          <html><body>login page of the lab stand</body></html>
      - path: /var/www/html/admin/index.html
        permissions: "0644"
        content: |
          <html><body>admin page of the lab stand</body></html>
      - path: /var/www/html/api/status
        permissions: "0644"
        content: |
          {"status": "ok", "stand": "mlsiem-lab"}
      # DNS: резолвер отвечает в пределах стенда (имя lab.test → жертва), наружу не ходит
      - path: /etc/dnsmasq.d/mlsiem-lab.conf
        permissions: "0644"
        content: |
          listen-address={{ lab.victim.ip }}
          bind-interfaces
          no-resolv
          address=/lab.test/{{ lab.victim.ip }}
      # FTP: анонимный доступ только на чтение (нормальный трафик «передачи файлов»)
      - path: /etc/vsftpd.conf
        permissions: "0644"
        content: |
          listen=YES
          anonymous_enable=YES
          local_enable=NO
          write_enable=NO
          anon_root=/srv/ftp
          pasv_enable=YES
          pasv_min_port=40000
          pasv_max_port=40100
      - path: /srv/ftp/readme.txt
        permissions: "0644"
        content: |
          mlsiem lab stand: public file
    runcmd:
      # Освобождаем порт 53 от stub-слушателя systemd-resolved — иначе dnsmasq не поднимется
      - [bash, -c, "sed -i 's/^#\\?DNSStubListener=.*/DNSStubListener=no/' /etc/systemd/resolved.conf && systemctl restart systemd-resolved || true"]
      # Ставим службы жертвы на первой загрузке (интернет ещё есть через install-адаптер).
      # Сбой здесь не валит установку ОС — в отличие от этапа curtin
      - [bash, -c, "export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y nginx vsftpd dnsmasq"]
      - [systemctl, enable, --now, nginx]
      - [systemctl, enable, --now, vsftpd]
      - [systemctl, enable, --now, dnsmasq]
